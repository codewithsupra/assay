# Assay server configuration. Copy to server/.env for local overrides.

# Postgres. Dev/test default to postgres://localhost:5432/assay_(dev|test).
DATABASE_URL=postgres://localhost:5432/assay_dev

# Required in production.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Ed25519 signing key (PKCS#8 PEM). Generate one and keep it stable so the
# public verification key never changes:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
# In dev/test an ephemeral key is generated automatically if this is unset.
SIGNING_KEY_PEM=

PORT=8001
PUBLIC_BASE_URL=http://localhost:8001

# Consent / rate guardrails.
PROBE_TIMEOUT_MS=10000
MIN_PROBE_INTERVAL_S=30
JOB_LEASE_MS=60000
