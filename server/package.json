{
  "name": "assay-server",
  "version": "0.1.0",
  "description": "Assay — verified proof-of-skill for deployed projects (server)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:runner": "node src/runner.js",
    "dev": "NODE_ENV=development node --watch src/index.js",
    "dev:runner": "NODE_ENV=development node --watch src/runner.js",
    "migrate": "node src/db/migrate.js",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "autocannon": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
